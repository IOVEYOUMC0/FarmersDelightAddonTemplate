.gradle/
build/
bin/
out/
*.class

# The FarmersDelight api facade jar (compile-only). It is the output of the composite build's apiJar
# sync, committed so the api surface this template compiles against is visible in the tree; every build
# rewrites it. Nothing else may live under libs/.
libs/*
!libs/farmersdelight-api.jar

.idea/
*.iml
.vscode/
local.properties
